[
  {"id":"q001","dimension":"thinking","text":"当阅读一篇观点性文章时，我习惯分析它的论证结构而非仅仅关注结论","reverse":false,"source":"NFC #Q04 adapted","weight":0.95},
  {"id":"q002","dimension":"thinking","text":"做决定时，我倾向于收集更多信息后再下判断，即使这意味着决策速度变慢","reverse":false,"source":"NFC #Q01 adapted","weight":0.95},
  {"id":"q003","dimension":"thinking","text":"比起听别人讲述经验，我更愿意自己动手尝试找出规律","reverse":false,"source":"self","weight":0.8},
  {"id":"q004","dimension":"emotional","text":"即使事情不按计划发展，我也能在过程找到新的乐趣","reverse":false,"source":"BigFive-Neuroticism #Q08 adapted","weight":0.9},
  {"id":"q005","dimension":"thinking","text":"我很难对复杂抽象的理论问题提起兴趣","reverse":true,"source":"NFC #Q12 adapted","weight":0.9},
  {"id":"q006","dimension":"creativity","text":"我喜欢把看似不相关的想法拼接在一起，看能产生什么新的东西","reverse":false,"source":"self","weight":0.75},

  {"id":"q007","dimension":"drive","text":"对于真正重要的事，我会主动投入额外的时间，即便没有人要求","reverse":false,"source":"Grit #Q01 adapted","weight":0.95},
  {"id":"q008","dimension":"social","text":"当身边的人看起来不太对劲，我往往是第一个察觉到的人","reverse":false,"source":"self","weight":0.8},
  {"id":"q009","dimension":"creativity","text":"我对已有的做事方式保持尊重，但总忍不住想有没有更好的方法","reverse":false,"source":"BigFive-Openness #Q12 adapted","weight":0.9},
  {"id":"q010","dimension":"emotional","text":"感到愤怒或沮丧的时候，我通常能保持理性的行为不被情绪支配","reverse":false,"source":"self","weight":0.75},
  {"id":"q011","dimension":"execution","text":"我开始做一件事之后，很少会半途而废","reverse":false,"source":"Grit #Q03 adapted","weight":0.95},
  {"id":"q012","dimension":"drive","text":"大家觉得我目标明确、知道自己想要什么","reverse":false,"source":"SDT #Q03 adapted","weight":0.9},

  {"id":"q013","dimension":"social","text":"比起在人群中活跃气氛，我更享受和朋友小范围深入的聊天","reverse":true,"source":"BigFive-Extraversion #Q15 adapted","weight":0.9},
  {"id":"q014","dimension":"execution","text":"我的桌面、文件夹或日程表通常保持有序，东西很少找不到","reverse":false,"source":"BigFive-Conscientiousness #Q04 adapted","weight":0.9},
  {"id":"q015","dimension":"emotional","text":"遇到挑战和挫折后，我需要比较长的时间才能恢复状态","reverse":true,"source":"BigFive-Neuroticism #Q10 adapted","weight":0.95},
  {"id":"q016","dimension":"social","text":"帮助朋友分析他们遇到的困难，让我觉得自己在做有意义的事","reverse":false,"source":"self","weight":0.75},
  {"id":"q017","dimension":"execution","text":"我常常给自己设定截止时间，哪怕外界没有明确要求","reverse":false,"source":"self","weight":0.75},
  {"id":"q018","dimension":"creativity","text":"我喜欢秩序和规则，变化通常会让我感到不安","reverse":true,"source":"BigFive-Openness #Q20 adapted","weight":0.9},

  {"id":"q019","dimension":"drive","text":"我对现在在做的事充满热情，很少觉得是在'熬时间'","reverse":false,"source":"SDT #Q05 adapted","weight":0.9},
  {"id":"q020","dimension":"emotional","text":"在不确定结果时，我仍然能够安心行动，而不是一直焦虑等待","reverse":false,"source":"self","weight":0.7},
  {"id":"q021","dimension":"thinking","text":"与人讨论问题时，我更在意对方的逻辑是否自洽，而非观点是否和我一致","reverse":false,"source":"NFC #Q07 adapted","weight":0.9},
  {"id":"q022","dimension":"execution","text":"如果一件事没有明确的完成标准，我很难有动力去推进它","reverse":true,"source":"self","weight":0.75},
  {"id":"q023","dimension":"social","text":"在一个全新的群体里，我通常需要一点时间观察后才会主动接触别人","reverse":true,"source":"BigFive-Extraversion #Q01 adapted","weight":0.9},
  {"id":"q024","dimension":"creativity","text":"面对一个问题，我会先想有没有人遇到过——而不是自己先想出独特解法","reverse":true,"source":"self","weight":0.7},

  {"id":"q025","dimension":"emotional","text":"身边的人很少见到我慌乱或失控的样子","reverse":false,"source":"BigFive-Neuroticism #Q01 adapted","weight":0.95},
  {"id":"q026","dimension":"drive","text":"我觉得需要外部奖励或表扬才会有动力，靠自己很难坚持","reverse":true,"source":"SDT #Q12 adapted","weight":0.9},
  {"id":"q027","dimension":"thinking","text":"我喜欢琢磨那些考验耐心的智力游戏或逻辑谜题","reverse":false,"source":"NFC #Q09 adapted","weight":0.95},
  {"id":"q028","dimension":"social","text":"团队合作中我不喜欢模糊分工，宁愿各自有清晰的职责","reverse":true,"source":"self","weight":0.75},
  {"id":"q029","dimension":"execution","text":"就算是周末或假期，我也会保持一定的日常节奏，不会完全打乱","reverse":false,"source":"BigFive-Conscientiousness #Q08 adapted","weight":0.9},
  {"id":"q030","dimension":"creativity","text":"比起创造全新的东西，我更擅长在现有框架内做改进和优化","reverse":true,"source":"self","weight":0.7},

  {"id":"q031","dimension":"drive","text":"我相信个人的努力比外部环境更能决定一个人的发展轨迹","reverse":false,"source":"Grit #Q08 adapted","weight":0.85},
  {"id":"q032","dimension":"emotional","text":"做决定时，我承认感受很重要，但最终依靠理性来做判断","reverse":false,"source":"self","weight":0.75},
  {"id":"q033","dimension":"social","text":"我觉得理解一个人行为背后的原因，比评价这个行为本身更重要","reverse":false,"source":"BigFive-Agreeableness #Q02 adapted","weight":0.9},
  {"id":"q034","dimension":"execution","text":"我常常同时进行很多事，最后发现几乎没有一件完整收尾","reverse":true,"source":"BigFive-Conscientiousness #Q18 adapted","weight":0.95},
  {"id":"q035","dimension":"drive","text":"即使没有额外收益，我也经常在需要的地方多做一些","reverse":false,"source":"self","weight":0.75},
  {"id":"q036","dimension":"thinking","text":"当别人告诉我一个'常识'时，我会下意识验证它是否真的有依据","reverse":false,"source":"self","weight":0.8}
]
